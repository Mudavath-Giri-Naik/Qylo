# URL of the deployed Next.js frontend, for CORS
FRONTEND_URL=http://localhost:3000

# Supabase project settings (server-side reads: users, progress, submissions, lessons)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API (embeddings + chat) -- https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Qdrant Cloud (lesson vector search) -- https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.your-region.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
